using System.Diagnostics;
using System.Globalization;
using System.Text.Json;

namespace CodexLimits.Core;

public sealed class CodexAppServerClient : IUsageProvider
{
    public async Task<UsageSnapshot> FetchAsync(CancellationToken cancellationToken = default)
    {
        var executable = CodexExecutableLocator.Find()
            ?? throw new InvalidOperationException(
                "Codex CLI est introuvable. Vérifie que codex est installé et accessible dans le PATH, " +
                "ou définis CODEX_LIMITS_CODEX_PATH.");

        using var timeout = CancellationTokenSource.CreateLinkedTokenSource(cancellationToken);
        timeout.CancelAfter(TimeSpan.FromSeconds(15));

        var isCommandScript = Path.GetExtension(executable).Equals(".cmd", StringComparison.OrdinalIgnoreCase) ||
                              Path.GetExtension(executable).Equals(".bat", StringComparison.OrdinalIgnoreCase);
        var startInfo = new ProcessStartInfo
        {
            FileName = isCommandScript ? Environment.GetEnvironmentVariable("COMSPEC") ?? "cmd.exe" : executable,
            RedirectStandardInput = true,
            RedirectStandardOutput = true,
            RedirectStandardError = true,
            UseShellExecute = false,
            CreateNoWindow = true
        };
        if (isCommandScript)
        {
            startInfo.ArgumentList.Add("/d");
            startInfo.ArgumentList.Add("/c");
            startInfo.ArgumentList.Add(executable);
        }
        startInfo.ArgumentList.Add("app-server");
        startInfo.ArgumentList.Add("--listen");
        startInfo.ArgumentList.Add("stdio://");

        using var process = new Process { StartInfo = startInfo };
        try
        {
            if (!process.Start())
            {
                throw new InvalidOperationException("Impossible de démarrer codex app-server.");
            }

            await process.StandardInput.WriteLineAsync(
                "{\"id\":1,\"method\":\"initialize\",\"params\":{\"clientInfo\":{\"name\":\"codex-limits-windows\",\"title\":\"Codex Limits Windows\",\"version\":\"0.1.0\"},\"capabilities\":{\"experimentalApi\":true}}}");
            await process.StandardInput.FlushAsync();

            JsonElement? rateLimits = null;
            JsonElement? usage = null;
            var fetchedAt = DateTimeOffset.UtcNow;

            while (!timeout.Token.IsCancellationRequested)
            {
                var line = await process.StandardOutput.ReadLineAsync(timeout.Token);
                if (line is null)
                {
                    break;
                }

                using var document = JsonDocument.Parse(line);
                var root = document.RootElement;
                if (!root.TryGetProperty("id", out var idElement) || !idElement.TryGetInt32(out var id))
                {
                    continue;
                }

                if (root.TryGetProperty("error", out _))
                {
                    throw new InvalidOperationException("Codex app-server a renvoyé une erreur.");
                }

                if (id == 1)
                {
                    await process.StandardInput.WriteLineAsync("{\"method\":\"initialized\"}");
                    await process.StandardInput.WriteLineAsync("{\"id\":2,\"method\":\"account/rateLimits/read\"}");
                    await process.StandardInput.WriteLineAsync("{\"id\":3,\"method\":\"account/usage/read\"}");
                    await process.StandardInput.FlushAsync();
                }
                else if (id == 2)
                {
                    rateLimits = root.Clone();
                }
                else if (id == 3)
                {
                    usage = root.Clone();
                }

                if (rateLimits.HasValue && usage.HasValue)
                {
                    return Decode(rateLimits.Value, usage.Value, fetchedAt);
                }
            }

            throw new TimeoutException("Codex n’a pas renvoyé les données de quota à temps.");
        }
        catch (OperationCanceledException) when (timeout.IsCancellationRequested && !cancellationToken.IsCancellationRequested)
        {
            throw new TimeoutException("Codex n’a pas renvoyé les données de quota à temps.");
        }
        finally
        {
            try
            {
                if (!process.HasExited)
                {
                    process.Kill(entireProcessTree: true);
                }
            }
            catch (InvalidOperationException)
            {
                // Process was never started or already exited.
            }
        }
    }

    public static UsageSnapshot Decode(JsonElement rateResponse, JsonElement usageResponse, DateTimeOffset fetchedAt)
    {
        var rateResult = GetRequiredResult(rateResponse);
        var usageResult = GetRequiredResult(usageResponse);

        var snapshots = new Dictionary<string, JsonElement>(StringComparer.OrdinalIgnoreCase);
        if (rateResult.TryGetProperty("rateLimitsByLimitId", out var byId) && byId.ValueKind == JsonValueKind.Object)
        {
            foreach (var property in byId.EnumerateObject())
            {
                snapshots[property.Name] = property.Value;
            }
        }

        if (rateResult.TryGetProperty("rateLimits", out var fallbackRateLimits))
        {
            snapshots.TryAdd("codex", fallbackRateLimits);
        }

        if (!snapshots.TryGetValue("codex", out var mainSnapshot))
        {
            throw new InvalidOperationException("Codex n’a pas renvoyé de limite principale exploitable.");
        }

        var mainWindows = ReadWindows(mainSnapshot).ToArray();
        if (mainWindows.Length == 0)
        {
            throw new InvalidOperationException("Codex n’a pas renvoyé de fenêtre de quota exploitable.");
        }

        var mainWindow = mainWindows.MinBy(window => window.RemainingPercent)!;
        var otherLimits = new List<LimitReading>();

        foreach (var window in mainWindows.Where(window => window != mainWindow))
        {
            otherLimits.Add(new LimitReading("codex", WindowName(window.DurationMinutes), window));
        }

        foreach (var (id, snapshot) in snapshots.Where(pair => !pair.Key.Equals("codex", StringComparison.OrdinalIgnoreCase)))
        {
            var windows = ReadWindows(snapshot).ToArray();
            if (windows.Length == 0)
            {
                continue;
            }

            var selected = windows.MinBy(window => window.RemainingPercent)!;
            var name = snapshot.TryGetProperty("limitName", out var nameElement) && nameElement.ValueKind == JsonValueKind.String
                ? nameElement.GetString() ?? id
                : id;
            otherLimits.Add(new LimitReading(id, name, selected));
        }

        var tokenHistory = new List<TokenDay>();
        if (usageResult.TryGetProperty("dailyUsageBuckets", out var buckets) && buckets.ValueKind == JsonValueKind.Array)
        {
            foreach (var bucket in buckets.EnumerateArray())
            {
                if (!bucket.TryGetProperty("startDate", out var dateElement) || dateElement.ValueKind != JsonValueKind.String)
                {
                    continue;
                }

                var dateText = dateElement.GetString();
                if (!DateTimeOffset.TryParseExact(
                        dateText,
                        "yyyy-MM-dd",
                        CultureInfo.InvariantCulture,
                        DateTimeStyles.AssumeUniversal,
                        out var date))
                {
                    continue;
                }

                if (!bucket.TryGetProperty("tokens", out var tokensElement) || !tokensElement.TryGetInt64(out var tokens))
                {
                    continue;
                }

                tokenHistory.Add(new TokenDay(date, tokens));
            }
        }

        return new UsageSnapshot(
            new LimitReading("codex", "Codex", mainWindow),
            otherLimits.OrderBy(limit => limit.Name, StringComparer.OrdinalIgnoreCase).ToArray(),
            tokenHistory,
            fetchedAt);
    }

    private static JsonElement GetRequiredResult(JsonElement response)
    {
        if (!response.TryGetProperty("result", out var result) || result.ValueKind != JsonValueKind.Object)
        {
            throw new InvalidOperationException("Réponse Codex invalide.");
        }

        return result;
    }

    private static IEnumerable<UsageWindow> ReadWindows(JsonElement snapshot)
    {
        foreach (var propertyName in new[] { "primary", "secondary" })
        {
            if (!snapshot.TryGetProperty(propertyName, out var window) || window.ValueKind != JsonValueKind.Object)
            {
                continue;
            }

            if (!window.TryGetProperty("usedPercent", out var usedElement) || !usedElement.TryGetDouble(out var usedPercent))
            {
                continue;
            }

            if (!window.TryGetProperty("windowDurationMins", out var durationElement) || !durationElement.TryGetInt32(out var duration))
            {
                continue;
            }

            if (!window.TryGetProperty("resetsAt", out var resetElement) || !resetElement.TryGetInt64(out var resetsAt))
            {
                continue;
            }

            yield return new UsageWindow(
                Math.Clamp(100 - usedPercent, 0, 100),
                DateTimeOffset.FromUnixTimeSeconds(resetsAt),
                duration);
        }
    }

    private static string WindowName(int minutes)
    {
        if (minutes == 10_080) return "Fenêtre hebdomadaire";
        if (minutes % 60 == 0) return $"Fenêtre de {minutes / 60} h";
        return "Fenêtre supplémentaire";
    }
}

