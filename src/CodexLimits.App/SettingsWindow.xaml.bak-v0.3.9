<Window x:Class="CodexLimits.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ParamÃ¨tres"
        Width="430" Height="620"
        MinWidth="430" MinHeight="620"
        MaxWidth="430" MaxHeight="620"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource PrimaryText}"
        FontFamily="Segoe UI"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="ReadableComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Foreground" Value="#FF111111" />
            <Setter Property="Background" Value="#FFF5F5F5" />
            <Setter Property="BorderBrush" Value="#FF66758A" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#FF111111" />
                        <Setter Property="Background" Value="#FFFFFFFF" />
                        <Setter Property="Padding" Value="8,5" />
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="#FFBFE5FA" />
                                <Setter Property="Foreground" Value="#FF111111" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#FF9ED7F4" />
                                <Setter Property="Foreground" Value="#FF111111" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="TitleText" Text="ParamÃ¨tres" FontSize="22" FontWeight="Bold" />
            <TextBlock x:Name="SubtitleText"
                       Text="Planning, rÃ©serve et frÃ©quence dâ€™actualisation."
                       Foreground="{StaticResource SecondaryText}"
                       Margin="0,6,0,0"
                       FontSize="13" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="170" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="LanguageLabel" Text="Langue" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
            <ComboBox x:Name="LanguageCombo"
                      Grid.Column="1"
                      Height="30"
                      VerticalAlignment="Center"
                      Style="{StaticResource ReadableComboBox}"
                      DisplayMemberPath="Label"
                      SelectedValuePath="Value"
                      SelectionChanged="LanguageCombo_SelectionChanged" />
        </Grid>

        <Border Grid.Row="3" Height="1" Background="#FF243044" />

        <Grid Grid.Row="4" Margin="0,14,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="110" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="StartLabel" Text="DÃ©but" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8" />
            <TextBlock x:Name="StartTimeLabel" Grid.Column="1" Text="Heure" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8" />
            <ComboBox x:Name="StartDayCombo"
                      Grid.Row="1"
                      Margin="0,0,12,0"
                      Height="30"
                      Style="{StaticResource ReadableComboBox}"
                      DisplayMemberPath="Label"
                      SelectedValuePath="Value" />
            <TextBox x:Name="StartTimeBox" Grid.Row="1" Grid.Column="1" Height="30" VerticalContentAlignment="Center" />
        </Grid>

        <Border Grid.Row="5" Height="1" Background="#FF243044" />

        <Grid Grid.Row="6" Margin="0,14,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="110" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="EndLabel" Text="Fin" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8" />
            <TextBlock x:Name="EndTimeLabel" Grid.Column="1" Text="Heure" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8" />
            <ComboBox x:Name="EndDayCombo"
                      Grid.Row="1"
                      Margin="0,0,12,0"
                      Height="30"
                      Style="{StaticResource ReadableComboBox}"
                      DisplayMemberPath="Label"
                      SelectedValuePath="Value" />
            <TextBox x:Name="EndTimeBox" Grid.Row="1" Grid.Column="1" Height="30" VerticalContentAlignment="Center" />
        </Grid>

        <Border Grid.Row="7" Height="1" Background="#FF243044" />

        <Grid Grid.Row="8" Margin="0,14,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="130" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="RefreshLabel" Text="Actualisation automatique" FontWeight="SemiBold" FontSize="15" />
            <TextBlock x:Name="RefreshHintText" Grid.Row="1" Text="Intervalle en minutes" Foreground="{StaticResource SecondaryText}" Margin="0,8,0,0" FontSize="12" />
            <ComboBox x:Name="RefreshIntervalCombo"
                      Grid.Column="1"
                      Grid.RowSpan="2"
                      IsEditable="True"
                      Height="30"
                      VerticalAlignment="Center"
                      Style="{StaticResource ReadableComboBox}" />
        </Grid>

        <Border Grid.Row="9" Height="1" Background="#FF243044" />

        <Grid Grid.Row="10" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="120" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="ReserveLabel" Text="RÃ©serve de sÃ©curitÃ©" FontWeight="SemiBold" FontSize="15" />
            <TextBlock x:Name="ReserveHintText" Grid.Row="1" Text="Pourcentage Ã  conserver" Foreground="{StaticResource SecondaryText}" Margin="0,8,0,0" FontSize="12" />
            <StackPanel Grid.Column="1" Grid.RowSpan="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                <TextBox x:Name="SafetyBufferBox" Width="64" Height="30" VerticalContentAlignment="Center" />
                <TextBlock Text=" %" VerticalAlignment="Center" FontSize="14" Margin="6,0,0,0" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="11" Margin="0,14,0,0">
            <CheckBox x:Name="PauseOutsideCheckBox"
                      Content="Suspendre lâ€™actualisation automatique hors crÃ©neau"
                      Margin="0,0,0,14" />
            <TextBlock x:Name="ValidationText"
                       Foreground="{StaticResource WarningBrush}"
                       TextWrapping="Wrap"
                       FontSize="12" />
        </StackPanel>

        <Grid Grid.Row="12" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="CancelButton"
                    Grid.Column="1"
                    Content="Annuler"
                    Margin="0,0,10,0"
                    Padding="14,8"
                    Click="CancelButton_Click" />
            <Button x:Name="SaveButton"
                    Grid.Column="2"
                    Content="Enregistrer"
                    Padding="14,8"
                    Background="#FF245FB3"
                    BorderBrush="#FF4A84D8"
                    Click="SaveButton_Click" />
        </Grid>
    </Grid>
</Window>