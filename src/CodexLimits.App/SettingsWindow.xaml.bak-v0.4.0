<Window x:Class="CodexLimits.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paramètres"
        Width="430"
        Height="620"
        MinWidth="430"
        MinHeight="620"
        MaxWidth="430"
        MaxHeight="620"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource PrimaryText}"
        FontFamily="Segoe UI"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="HintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryText}" />
        </Style>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="10,4,10,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="InputComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="#111111" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Padding" Value="8,2,8,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#111111" />
            <Setter Property="FontSize" Value="15" />
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="TitleText" Text="Paramètres" FontSize="22" FontWeight="Bold" />
            <TextBlock x:Name="SubtitleText"
                       Text="Planning, réserve et fréquence d’actualisation."
                       Foreground="{StaticResource SecondaryText}"
                       Margin="0,8,0,0"
                       FontSize="13" />
        </StackPanel>

        <!-- Langue -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="190" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="LanguageLabel"
                       Text="Langue"
                       Style="{StaticResource FieldLabelStyle}"
                       VerticalAlignment="Center" />

            <ComboBox x:Name="LanguageCombo"
                      Grid.Column="1"
                      Style="{StaticResource InputComboStyle}"
                      SelectionChanged="LanguageCombo_SelectionChanged" />
        </Grid>

        <Border Grid.Row="3" Height="1" Background="#FF243044" />

        <!-- Début -->
        <Grid Grid.Row="4" Margin="0,16,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="142" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="StartLabel"
                       Text="Début"
                       Style="{StaticResource FieldLabelStyle}" />

            <TextBlock x:Name="StartTimeLabel"
                       Grid.Column="1"
                       Text="Heure"
                       Style="{StaticResource FieldLabelStyle}" />

            <ComboBox x:Name="StartDayCombo"
                      Grid.Row="2"
                      Style="{StaticResource InputComboStyle}"
                      Margin="0,0,14,0"
                      DisplayMemberPath="Label"
                      SelectedValuePath="Value" />

            <TextBox x:Name="StartTimeBox"
                     Grid.Row="2"
                     Grid.Column="1"
                     Style="{StaticResource InputTextBoxStyle}" />
        </Grid>

        <Border Grid.Row="5" Height="1" Background="#FF243044" />

        <!-- Fin -->
        <Grid Grid.Row="6" Margin="0,16,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="142" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="EndLabel"
                       Text="Fin"
                       Style="{StaticResource FieldLabelStyle}" />

            <TextBlock x:Name="EndTimeLabel"
                       Grid.Column="1"
                       Text="Heure"
                       Style="{StaticResource FieldLabelStyle}" />

            <ComboBox x:Name="EndDayCombo"
                      Grid.Row="2"
                      Style="{StaticResource InputComboStyle}"
                      Margin="0,0,14,0"
                      DisplayMemberPath="Label"
                      SelectedValuePath="Value" />

            <TextBox x:Name="EndTimeBox"
                     Grid.Row="2"
                     Grid.Column="1"
                     Style="{StaticResource InputTextBoxStyle}" />
        </Grid>

        <Border Grid.Row="7" Height="1" Background="#FF243044" />

        <!-- Refresh -->
        <Grid Grid.Row="8" Margin="0,16,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="142" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="RefreshLabel"
                       Text="Actualisation automatique"
                       Style="{StaticResource FieldLabelStyle}" />

            <TextBlock x:Name="RefreshHintText"
                       Grid.Row="2"
                       Text="Intervalle en minutes"
                       Style="{StaticResource HintStyle}" />

            <ComboBox x:Name="RefreshIntervalCombo"
                      Grid.Column="1"
                      Grid.RowSpan="3"
                      Style="{StaticResource InputComboStyle}"
                      IsEditable="True"
                      VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="9" Height="1" Background="#FF243044" />

        <!-- Réserve -->
        <Grid Grid.Row="10" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="130" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="ReserveLabel"
                       Text="Réserve de sécurité"
                       Style="{StaticResource FieldLabelStyle}" />

            <TextBlock x:Name="ReserveHintText"
                       Grid.Row="2"
                       Text="Pourcentage à conserver"
                       Style="{StaticResource HintStyle}" />

            <StackPanel Grid.Column="1"
                        Grid.RowSpan="3"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right">
                <TextBox x:Name="SafetyBufferBox"
                         Style="{StaticResource InputTextBoxStyle}"
                         Width="86" />
                <TextBlock Text="%"
                           FontSize="18"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="11" Margin="0,16,0,0">
            <CheckBox x:Name="PauseOutsideCheckBox"
                      Content="Suspendre l’actualisation automatique hors créneau"
                      Margin="0,0,0,14" />
            <TextBlock x:Name="ValidationText"
                       Foreground="{StaticResource WarningBrush}"
                       TextWrapping="Wrap"
                       FontSize="12" />
        </StackPanel>

        <Grid Grid.Row="12" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="CancelButton"
                    Grid.Column="1"
                    Content="Annuler"
                    Margin="0,0,12,0"
                    Padding="18,10"
                    Click="CancelButton_Click" />

            <Button x:Name="SaveButton"
                    Grid.Column="2"
                    Content="Enregistrer"
                    Padding="18,10"
                    Background="#FF245FB3"
                    BorderBrush="#FF4A84D8"
                    Click="SaveButton_Click" />
        </Grid>
    </Grid>
</Window>