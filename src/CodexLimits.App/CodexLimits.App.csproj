<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>CodexLimits.Windows</AssemblyName>
    <RootNamespace>CodexLimits.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\docs\icon.ico</ApplicationIcon>

    <Version>0.6.4</Version>
    <AssemblyVersion>0.6.4.0</AssemblyVersion>
    <FileVersion>0.6.4.0</FileVersion>
    <InformationalVersion>0.6.4</InformationalVersion>
    <Product>Codex Limits Windows</Product>
    <Title>Codex Limits Windows</Title>
    <Description>Independent Windows quota monitor and pacing assistant for the Codex CLI.</Description>
    <Company>Codex Limits Windows contributors</Company>
    <Authors>Codex Limits Windows contributors</Authors>
    <Copyright>Copyright © 2026 Codex Limits Windows contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <NeutralLanguage>fr-FR</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodexLimits.Core\CodexLimits.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\docs\icon.png">
      <Link>docs\icon.png</Link>
      <LogicalName>docs/icon.png</LogicalName>
    </Resource>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Link="README.md" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\LICENSE" Link="LICENSE" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\PRIVACY.md" Link="PRIVACY.md" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\SECURITY.md" Link="SECURITY.md" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\TRADEMARKS.md" Link="TRADEMARKS.md" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
