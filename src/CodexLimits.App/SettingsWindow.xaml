<Window x:Class="CodexLimits.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paramètres"
        Width="430" Height="620"
        MinWidth="430" MinHeight="620"
        MaxWidth="430" MaxHeight="620"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource PrimaryText}"
        FontFamily="Segoe UI"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="ReadableComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Foreground" Value="#FF111111" />
            <Setter Property="Background" Value="#FFF5F5F5" />
            <Setter Property="BorderBrush" Value="#FF66758A" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#FF111111" />
                        <Setter Property="Background" Value="#FFFFFFFF" />
                        <Setter Property="Padding" Value="8,5" />
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="#FFBFE5FA" />
                                <Setter Property="Foreground" Value="#FF111111" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#FF9ED7F4" />
                                <Setter Property="Foreground" Value="#FF111111" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="TitleText" Text="Paramètres" FontSize="22" FontWeight="Bold" />
            <TextBlock x:Name="SubtitleText" Text="Planning, réserve et fréquence d’actualisation."
                       Foreground="{StaticResource SecondaryText}" Margin="0,4,0,0" FontSize="12" />
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="11">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="145" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="LanguageLabel" Text="Langue" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                <ComboBox x:Name="LanguageCombo" Grid.Column="1" Style="{StaticResource ReadableComboBox}"
                          DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectionChanged="LanguageCombo_SelectionChanged" />
            </Grid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="11">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="92" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="StartLabel" Text="Début" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,5" />
                <ComboBox x:Name="StartDayCombo" Grid.Row="1" Margin="0,0,8,0"
                          Style="{StaticResource ReadableComboBox}"
                          DisplayMemberPath="Label" SelectedValuePath="Value" />
                <TextBlock x:Name="StartTimeLabel" Grid.Column="1" Text="Heure" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,5" />
                <TextBox x:Name="StartTimeBox" Grid.Row="1" Grid.Column="1" />
            </Grid>
        </Border>

        <Border Grid.Row="6" Style="{StaticResource CardStyle}" Padding="11">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="92" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="EndLabel" Text="Fin" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,5" />
                <ComboBox x:Name="EndDayCombo" Grid.Row="1" Margin="0,0,8,0"
                          Style="{StaticResource ReadableComboBox}"
                          DisplayMemberPath="Label" SelectedValuePath="Value" />
                <TextBlock x:Name="EndTimeLabel" Grid.Column="1" Text="Heure" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,5" />
                <TextBox x:Name="EndTimeBox" Grid.Row="1" Grid.Column="1" />
            </Grid>
        </Border>

        <Border Grid.Row="8" Style="{StaticResource CardStyle}" Padding="11">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="RefreshLabel" Text="Actualisation automatique" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock x:Name="RefreshHintText" Text="Intervalle en minutes" Foreground="{StaticResource SecondaryText}" Margin="0,4,0,0" FontSize="11" />
                </StackPanel>
                <ComboBox x:Name="RefreshIntervalCombo" Grid.Column="1" IsEditable="True" VerticalAlignment="Center"
                          Style="{StaticResource ReadableComboBox}" />
            </Grid>
        </Border>

        <Border Grid.Row="10" Style="{StaticResource CardStyle}" Padding="11">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="88" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="ReserveLabel" Text="Réserve de sécurité" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock x:Name="ReserveHintText" Text="Pourcentage à conserver" Foreground="{StaticResource SecondaryText}" Margin="0,4,0,0" FontSize="11" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox x:Name="SafetyBufferBox" Width="52" />
                    <TextBlock Text=" %" VerticalAlignment="Center" FontSize="13" />
                </StackPanel>
            </Grid>
        </Border>

        <CheckBox x:Name="PauseOutsideCheckBox" Grid.Row="11" Margin="3,7,0,0"
                  Content="Suspendre l’actualisation automatique hors créneau" FontSize="11" />

        <Grid Grid.Row="13" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ValidationText" Foreground="{StaticResource WarningBrush}"
                       VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0" FontSize="11" />
            <Button x:Name="CancelButton" Grid.Column="1" Content="Annuler" Margin="0,0,8,0" Padding="12,7" Click="CancelButton_Click" />
            <Button x:Name="SaveButton" Grid.Column="2" Content="Enregistrer" Padding="12,7"
                    Background="#FF245FB3" BorderBrush="#FF4A84D8" Click="SaveButton_Click" />
        </Grid>
    </Grid>
</Window>
