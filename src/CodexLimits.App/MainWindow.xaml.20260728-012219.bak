<Window x:Class="CodexLimits.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CodexLimits.App.Controls"
        Title="Codex Limits Windows"
        Width="591" Height="650" MinWidth="591" MinHeight="650" MaxWidth="591" MaxHeight="650"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource PrimaryText}"
        FontFamily="Segoe UI"
        Closing="Window_Closing"
        Loaded="Window_Loaded">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition Height="*" />
            <RowDefinition Height="1" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Codex Limits"
                       FontSize="24"
                       FontWeight="Bold"
                       VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                <TextBlock Text="{Binding RemainingText}" FontSize="17" FontWeight="Bold" />
                <TextBlock Text=" % restant" Margin="4,2,0,0" Foreground="{StaticResource SecondaryText}" FontSize="12" />
            </StackPanel>

            <Border Grid.Column="2" Width="1" Height="24" Background="#FF243044" Margin="14,0,0,0" VerticalAlignment="Center" />

            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <TextBlock Text="{Binding UsedValueText}" FontSize="17" FontWeight="Bold" />
                <TextBlock Text=" % utilisés" Margin="4,2,0,0" Foreground="{StaticResource SecondaryText}" FontSize="12" />
            </StackPanel>

            <TextBlock Grid.Column="4"
                       Text="{Binding UpdatedText}"
                       Foreground="{StaticResource SecondaryText}"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Margin="14,0,0,0" />

            <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="14,0,0,0">
                <Button Content="⚙"
                        ToolTip="Paramètres"
                        Click="SettingsButton_Click"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        Width="24"
                        Height="24"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Margin="0,0,18,0" />
                <Button Content="↻"
                        ToolTip="Actualiser"
                        Click="RefreshButton_Click"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        Width="30"
                        Height="30"
                        FontSize="24"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        VerticalAlignment="Center"
                        Margin="0,-3,0,0" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Height="1" Background="#FF243044" />

        <!-- Status -->
        <Grid Grid.Row="2" Margin="0,14,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="!"
                       Foreground="{Binding StatusBrush}"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="0,0,10,0"
                       VerticalAlignment="Center" />

            <TextBlock Grid.Column="1"
                       Text="{Binding StatusTitle, Mode=OneWay}"
                       Foreground="{Binding StatusBrush}"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="0,0,10,0"
                       VerticalAlignment="Center" />

            <TextBlock Grid.Column="2"
                       Text="—"
                       Foreground="{StaticResource SecondaryText}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,0,10,0"
                       VerticalAlignment="Center" />

            <TextBlock Grid.Column="3"
                       Text="{Binding StatusMessage, Mode=OneWay}"
                       FontSize="13"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="3" Height="1" Background="#FF243044" />

        <!-- Chart -->
        <Grid Grid.Row="4" Margin="0,16,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Consommation"
                           FontSize="18"
                           FontWeight="Bold" />

                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="• Cible" Foreground="#FF34C759" Margin="0,0,12,0" FontSize="12" />
                    <TextBlock Text="• Réel" Foreground="#FF0A84FF" Margin="0,0,12,0" FontSize="12" />
                    <TextBlock Text="• Projection" Foreground="#FFFF675F" Margin="0,0,12,0" FontSize="12" />
                    <TextBlock Text="• Historique" Foreground="#FF919196" FontSize="12" />
                </WrapPanel>
            </Grid>

            <local:BurnDownChartControl x:Name="BurnChart" Grid.Row="1" />
        </Grid>

        <Border Grid.Row="5" Height="1" Background="#FF243044" />

        <!-- Schedule -->
        <Grid Grid.Row="6" Margin="0,14,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="9" Height="9" Fill="{Binding ScheduleStateBrush}" Margin="0,6,10,0" />
                    <TextBlock Text="{Binding SchedulePauseTitle}" FontSize="16" FontWeight="Bold" />
                </StackPanel>

                <TextBlock Text="{Binding ScheduleDetailText}"
                           Margin="0,6,0,0"
                           Foreground="{StaticResource SecondaryText}"
                           FontSize="12" />
            </StackPanel>

            <Button Grid.Column="1"
                    Content="Modifier"
                    Click="SettingsButton_Click"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="7" Height="1" Background="#FF243044" />

        <!-- Metrics -->
        <UniformGrid Grid.Row="8" Columns="2" Rows="2" Margin="0,14,0,10">
            <Grid Margin="0,0,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Reset" Foreground="{StaticResource SecondaryText}" FontSize="11" />
                <TextBlock Grid.Row="1" Text="{Binding ResetText}" Margin="0,8,0,0" FontSize="12" FontWeight="Bold" TextWrapping="Wrap" />
            </Grid>

            <Grid Margin="12,0,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Épuisement estimé" Foreground="{StaticResource SecondaryText}" FontSize="11" />
                <TextBlock Grid.Row="1" Text="{Binding EstimatedExhaustionText}" Margin="0,8,0,0" FontSize="12" FontWeight="Bold" TextWrapping="Wrap" />
            </Grid>

            <Grid Margin="0,12,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Rythme conseillé" Foreground="{StaticResource SecondaryText}" FontSize="11" />
                <TextBlock Grid.Row="1" Text="{Binding SuggestedPaceText}" Margin="0,8,0,0" FontSize="12" FontWeight="Bold" TextWrapping="Wrap" />
            </Grid>

            <Grid Margin="12,12,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Rythme observé" Foreground="{StaticResource SecondaryText}" FontSize="11" />
                <TextBlock Grid.Row="1" Text="{Binding CurrentPaceText}" Margin="0,8,0,0" FontSize="12" FontWeight="Bold" TextWrapping="Wrap" />
            </Grid>
        </UniformGrid>

        <!-- Error -->
        <Border x:Name="ErrorPanel"
                Grid.Row="9"
                Visibility="Collapsed"
                Background="#221C2430"
                BorderBrush="#AAFF7369"
                BorderThickness="0,1,0,1"
                Padding="10"
                Margin="0,0,0,10">
            <TextBlock Text="{Binding ErrorText}"
                       Foreground="#FFFFA9A2"
                       TextWrapping="Wrap"
                       FontSize="11" />
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="10" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding PlanText}"
                       Foreground="{StaticResource SecondaryText}"
                       FontSize="11"
                       VerticalAlignment="Center" />

            <Button Grid.Column="1"
                    Content="Masquer"
                    Click="HideButton_Click"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Cursor="Hand" />
        </Grid>
    </Grid>
</Window>

