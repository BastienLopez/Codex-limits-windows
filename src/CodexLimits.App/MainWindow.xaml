<Window x:Class="CodexLimits.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CodexLimits.App.Controls"
        Title="Codex Limits Windows"
        Width="591" Height="650" MinWidth="591" MinHeight="650" MaxWidth="591" MaxHeight="650"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource PrimaryText}"
        FontFamily="Segoe UI"
        Icon="pack://application:,,,/docs/icon.png"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged"
        Loaded="Window_Loaded">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition Height="*" />
            <RowDefinition Height="1" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Codex Limits"
                       FontSize="22"
                       FontWeight="Bold"
                       VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                <TextBlock Text="{Binding RemainingText}" FontSize="17" FontWeight="Bold" />
                <TextBlock Text="{Binding RemainingLabel}" Margin="4,2,0,0" Foreground="{StaticResource SecondaryText}" FontSize="12" />
            </StackPanel>

            <Border Grid.Column="2" Width="1" Height="24" Background="#FF243044" Margin="10,0,0,0" VerticalAlignment="Center" />

            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                <TextBlock Text="{Binding UsedValueText}" FontSize="17" FontWeight="Bold" />
                <TextBlock Text="{Binding UsedLabel}" Margin="4,2,0,0" Foreground="{StaticResource SecondaryText}" FontSize="12" />
            </StackPanel>

            <TextBlock Grid.Column="4"
                       Text="{Binding UpdatedText}"
                       Foreground="{StaticResource SecondaryText}"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0" />

            <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,0,0,0">
                <Button Content="⚙"
                        ToolTip="{Binding SettingsTooltip}"
                        Click="SettingsButton_Click"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        Width="24"
                        Height="24"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Margin="0,0,18,0" />
                <Button Content="↻"
                        ToolTip="{Binding RefreshTooltip}"
                        Click="RefreshButton_Click"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        Width="30"
                        Height="30"
                        FontSize="24"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        VerticalAlignment="Center"
                        Margin="0,-3,0,0" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Height="1" Background="#FF243044" />

        <!-- Status -->
        <Grid Grid.Row="2" Margin="0,10,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="!"
                       Foreground="{Binding StatusBrush}"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="0,0,10,0"
                       VerticalAlignment="Center" />

            <TextBlock Grid.Column="1"
                       Text="{Binding StatusTitle, Mode=OneWay}"
                       Foreground="{Binding StatusBrush}"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="0,0,10,0"
                       VerticalAlignment="Center" />

            <TextBlock Grid.Column="2"
                       Text="—"
                       Foreground="{StaticResource SecondaryText}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,0,10,0"
                       VerticalAlignment="Center" />

            <TextBlock Grid.Column="3"
                       Text="{Binding StatusMessage, Mode=OneWay}"
                       FontSize="13"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="3" Height="1" Background="#FF243044" />

        <!-- Chart -->
        <Grid Grid.Row="4" Margin="0,10,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding ConsumptionTitle}"
                           FontSize="18"
                           FontWeight="Bold" />

                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                        <Grid Width="18" Height="8" Margin="0,0,6,0">
                            <Line X1="0" Y1="4" X2="18" Y2="4" Stroke="#FF34C759" StrokeThickness="2" StrokeDashArray="4,2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Grid>
                        <TextBlock Text="{Binding LegendTarget}" Foreground="#FF34C759" FontSize="12" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                        <Grid Width="18" Height="8" Margin="0,0,6,0">
                            <Line X1="0" Y1="4" X2="18" Y2="4" Stroke="#FF0A84FF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Grid>
                        <TextBlock Text="{Binding LegendActual}" Foreground="#FF0A84FF" FontSize="12" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                        <Grid Width="18" Height="8" Margin="0,0,6,0">
                            <Line X1="0" Y1="4" X2="18" Y2="4" Stroke="#FFFF675F" StrokeThickness="2" StrokeDashArray="6,3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Grid>
                        <TextBlock Text="{Binding LegendProjection}" Foreground="#FFFF675F" FontSize="12" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="18" Height="8" Margin="0,0,6,0">
                            <Line X1="0" Y1="4" X2="18" Y2="4" Stroke="#FF919196" StrokeThickness="2" StrokeDashArray="2,2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Grid>
                        <TextBlock Text="{Binding LegendHistorical}" Foreground="#FF919196" FontSize="12" />
                    </StackPanel>
                </WrapPanel>
            </Grid>

            <local:BurnDownChartControl x:Name="BurnChart" Grid.Row="1" />
        </Grid>

        <Border Grid.Row="5" Height="1" Background="#FF243044" />

        <!-- Schedule -->
        <Grid Grid.Row="6" Margin="0,10,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="9" Height="9" Fill="{Binding ScheduleStateBrush}" Margin="0,6,10,0" />
                    <TextBlock Text="{Binding SchedulePauseTitle}" FontSize="16" FontWeight="Bold" />
                </StackPanel>

                <TextBlock Text="{Binding ScheduleDetailText}"
                           Margin="0,6,0,0"
                           Foreground="{StaticResource SecondaryText}"
                           FontSize="12" />
            </StackPanel>

            <Button Grid.Column="1"
                    Content="{Binding ModifyLabel}"
                    Click="SettingsButton_Click"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="7" Height="1" Background="#FF243044" />

        <!-- Metrics -->
        <UniformGrid Grid.Row="8" Columns="2" Rows="2" Margin="0,10,0,8">
            <Grid Margin="0,0,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding ResetLabel}" Foreground="{StaticResource SecondaryText}" FontSize="11" />
                <TextBlock Grid.Row="1" Text="{Binding ResetText}" Margin="0,8,0,0" FontSize="12" FontWeight="Bold" TextWrapping="Wrap" />
            </Grid>

            <Grid Margin="12,0,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding ExhaustionLabel}" Foreground="{StaticResource SecondaryText}" FontSize="11" />
                <TextBlock Grid.Row="1" Text="{Binding EstimatedExhaustionText}" Margin="0,8,0,0" FontSize="12" FontWeight="Bold" TextWrapping="Wrap" />
            </Grid>

            <Grid Margin="0,12,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding SuggestedPaceLabel}" Foreground="{StaticResource SecondaryText}" FontSize="11" />
                <TextBlock Grid.Row="1" Text="{Binding SuggestedPaceText}" Margin="0,8,0,0" FontSize="12" FontWeight="Bold" TextWrapping="Wrap" />
            </Grid>

            <Grid Margin="12,12,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding ObservedPaceLabel}" Foreground="{StaticResource SecondaryText}" FontSize="11" />
                <TextBlock Grid.Row="1" Text="{Binding CurrentPaceText}" Margin="0,8,0,0" FontSize="12" FontWeight="Bold" TextWrapping="Wrap" />
            </Grid>
        </UniformGrid>

        <!-- Error -->
        <Border x:Name="ErrorPanel"
                Grid.Row="9"
                Visibility="Collapsed"
                Background="#221C2430"
                BorderBrush="#AAFF7369"
                BorderThickness="0,1,0,1"
                Padding="10"
                Margin="0,0,0,10">
            <TextBlock Text="{Binding ErrorText}"
                       Foreground="#FFFFA9A2"
                       TextWrapping="Wrap"
                       FontSize="11" />
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="10" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding PlanText}"
                       Foreground="{StaticResource SecondaryText}"
                       FontSize="11"
                       VerticalAlignment="Center" />

            <Button Grid.Column="1"
                    Content="{Binding HideLabel}"
                    Click="HideButton_Click"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Cursor="Hand" />
        </Grid>
    </Grid>
</Window>
