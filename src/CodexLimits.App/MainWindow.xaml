<Window x:Class="CodexLimits.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CodexLimits.App.Controls"
        Title="Codex Limits Windows"
        Width="560" Height="790" MinWidth="500" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource PrimaryText}"
        FontFamily="Segoe UI"
        Closing="Window_Closing"
        Loaded="Window_Loaded">
    <Border Margin="10" CornerRadius="18"
            Background="{StaticResource PanelBackground}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20">
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Codex Limits" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="Quota, rythme et projection locale" Margin="0,3,0,0"
                                   Foreground="{StaticResource SecondaryText}" FontSize="12" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="⚙" ToolTip="Configurer le planning"
                            Width="40" Height="36" FontSize="16" Padding="0"
                            Margin="0,0,8,0" Click="SettingsButton_Click" />
                    <Button Grid.Column="2" Content="{Binding RefreshButtonText}" ToolTip="Actualiser maintenant"
                            Width="40" Height="36" FontSize="19" Padding="0"
                            Click="RefreshButton_Click" />
                </Grid>

                <Border Padding="18" CornerRadius="14" Background="#FF17191C"
                        BorderBrush="#FF303338" BorderThickness="1">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding RemainingText}" FontSize="50" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="% restant" Margin="10,25,0,0"
                                       Foreground="{StaticResource SecondaryText}" FontWeight="SemiBold" />
                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="{Binding UsedText}" HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding UpdatedText}" HorizontalAlignment="Right"
                                           Foreground="{StaticResource SecondaryText}" FontSize="11" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                        <ProgressBar Value="{Binding RemainingProgress, Mode=OneWay}" Maximum="100" Height="8" Margin="0,12,0,0"
                                     Foreground="#FF0A84FF" Background="#FF292C31" BorderThickness="0" />
                    </StackPanel>
                </Border>

                <Border Margin="0,12,0,0" Padding="14" CornerRadius="12"
                        Background="#FF17191C" BorderBrush="#FF303338" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="●" Foreground="{Binding ScheduleStateBrush}" FontSize="13"
                                   VerticalAlignment="Top" Margin="0,1,10,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding ScheduleStateText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ScheduleText}" Margin="0,4,0,0"
                                       Foreground="{StaticResource SecondaryText}" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="Modifier" Margin="12,0,0,0"
                                VerticalAlignment="Center" Click="SettingsButton_Click" />
                    </Grid>
                </Border>

                <Border Margin="0,12,0,0" Padding="16" CornerRadius="12"
                        Background="#FF17191C" BorderBrush="#FF303338" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{Binding StatusTitle}" Foreground="{Binding StatusBrush}"
                                   FontSize="18" FontWeight="Bold" />
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SecondaryText}"
                                   Margin="0,5,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Margin="0,12,0,0" Padding="14" CornerRadius="12"
                        Background="#FF0E0F11" BorderBrush="#FF303338" BorderThickness="1">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Consommation" FontSize="14" FontWeight="SemiBold" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="• Target" Foreground="#FF34C759" Margin="0,0,10,0" FontSize="10" />
                                <TextBlock Text="• Actual" Foreground="#FF0A84FF" Margin="0,0,10,0" FontSize="10" />
                                <TextBlock Text="• Current" Foreground="#FFFF453A" Margin="0,0,10,0" FontSize="10" />
                                <TextBlock Text="• Historical" Foreground="#FF919196" FontSize="10" />
                            </StackPanel>
                        </Grid>
                        <local:BurnDownChartControl x:Name="BurnChart" Height="245" />
                    </StackPanel>
                </Border>

                <UniformGrid Columns="2" Margin="0,12,0,0">
                    <Border Margin="0,0,6,6" Padding="14" CornerRadius="12"
                            Background="#FF17191C" BorderBrush="#FF303338" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Reset" Foreground="{StaticResource SecondaryText}" FontSize="11" />
                            <TextBlock Text="{Binding ResetText}" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Margin="6,0,0,6" Padding="14" CornerRadius="12"
                            Background="#FF17191C" BorderBrush="#FF303338" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Épuisement estimé" Foreground="{StaticResource SecondaryText}" FontSize="11" />
                            <TextBlock Text="{Binding ExhaustionText}" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Margin="0,6,6,0" Padding="14" CornerRadius="12"
                            Background="#FF17191C" BorderBrush="#FF303338" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Rythme conseillé" Foreground="{StaticResource SecondaryText}" FontSize="11" />
                            <TextBlock Text="{Binding SuggestedPaceText}" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Margin="6,6,0,0" Padding="14" CornerRadius="12"
                            Background="#FF17191C" BorderBrush="#FF303338" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Rythme observé" Foreground="{StaticResource SecondaryText}" FontSize="11" />
                            <TextBlock Text="{Binding CurrentRateText}" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Margin="0,12,0,0" Padding="14" CornerRadius="12"
                        Background="#FF17191C" BorderBrush="#FF303338" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Autres limites" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding OtherLimits}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="145" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding Remaining}" FontWeight="SemiBold" Margin="12,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding Reset}"
                                                   Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border x:Name="ErrorPanel" Margin="0,12,0,0" Background="#22FF453A"
                        BorderBrush="#55FF453A" BorderThickness="1"
                        CornerRadius="10" Padding="12" Visibility="Collapsed">
                    <TextBlock Text="{Binding ErrorText}" Foreground="#FFFF8A80" TextWrapping="Wrap" />
                </Border>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding PlanText}" Foreground="{StaticResource SecondaryText}" FontSize="10" />
                        <TextBlock Text="Week-ends et heures inactives exclus des projections"
                                   Foreground="{StaticResource SecondaryText}" FontSize="10" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Réserve" Foreground="{StaticResource SecondaryText}"
                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="SafetyBufferBox" Width="46"
                                 Text="{Binding SafetyBuffer, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.#}}"
                                 Padding="5,3" KeyDown="SafetyBufferBox_KeyDown" />
                        <TextBlock Text="%" Margin="4,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Masquer" Click="HideButton_Click" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>

