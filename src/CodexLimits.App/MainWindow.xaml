<Window x:Class="CodexLimits.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CodexLimits.App.Controls"
        Title="Codex Limits Windows"
        Width="591" Height="650"
        MinWidth="591" MinHeight="650"
        MaxWidth="591" MaxHeight="650"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource PrimaryText}"
        FontFamily="Segoe UI"
        Closing="Window_Closing"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="BorderlessIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.48" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TextOnlyButton" TargetType="Button" BasedOn="{StaticResource BorderlessIconButton}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="8" />
            <RowDefinition Height="54" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="64" />
            <RowDefinition Height="8" />
            <RowDefinition Height="100" />
            <RowDefinition Height="0" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="13,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Codex Limits" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding RemainingText}" FontSize="17" FontWeight="Bold" />
                    <TextBlock Text="{Binding RemainingLabel}" Margin="4,3,0,0" Foreground="{StaticResource SecondaryText}" FontSize="11" />
                </StackPanel>

                <Border Grid.Column="2" Width="1" Height="22" Background="#FF26354A" HorizontalAlignment="Center" VerticalAlignment="Center" />

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding UsedValueText}" FontSize="17" FontWeight="Bold" />
                    <TextBlock Text="{Binding UsedLabel}" Margin="4,3,0,0" Foreground="{StaticResource SecondaryText}" FontSize="11" />
                </StackPanel>

                <Border Grid.Column="4" Width="1" Height="22" Background="#FF26354A" HorizontalAlignment="Center" VerticalAlignment="Center" />

                <TextBlock Grid.Column="5" Text="{Binding UpdatedText}" Foreground="{StaticResource SecondaryText}" FontSize="10" VerticalAlignment="Center" />

                <Button Grid.Column="7" Content="⚙" ToolTip="{Binding SettingsTooltip}"
                        Style="{StaticResource BorderlessIconButton}" Width="30" Height="30" FontSize="19"
                        Click="SettingsButton_Click" />

                <Button Grid.Column="9" Content="↻" ToolTip="{Binding RefreshTooltip}"
                        Style="{StaticResource BorderlessIconButton}" Width="40" Height="40" FontSize="25" FontWeight="Bold"
                        Click="RefreshButton_Click" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="13,9">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="9" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="9" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="9" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="!" Foreground="{Binding StatusBrush}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding StatusTitle, Mode=OneWay}" Foreground="{Binding StatusBrush}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="—" Foreground="{StaticResource SecondaryText}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="6" Text="{Binding StatusMessage, Mode=OneWay}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="13,9">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="24" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding ConsumptionTitle}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding LegendTarget}" Foreground="#FF34C759" Margin="0,0,9,0" FontSize="10" />
                        <TextBlock Text="{Binding LegendActual}" Foreground="#FF0A84FF" Margin="0,0,9,0" FontSize="10" />
                        <TextBlock Text="{Binding LegendProjection}" Foreground="#FFFF675F" Margin="0,0,9,0" FontSize="10" />
                        <TextBlock Text="{Binding LegendHistorical}" Foreground="#FF919196" FontSize="10" />
                    </WrapPanel>
                </Grid>

                <local:BurnDownChartControl x:Name="BurnChart" Grid.Row="1" Margin="0,3,0,0" VerticalAlignment="Stretch" />
            </Grid>
        </Border>

        <Border Grid.Row="6" Style="{StaticResource CardStyle}" Padding="13,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" Fill="{Binding ScheduleStateBrush}" Margin="0,5,8,0" />
                        <TextBlock Text="{Binding SchedulePauseTitle}" FontSize="13" FontWeight="Bold" />
                    </StackPanel>
                    <TextBlock Text="{Binding ScheduleDetailText}" Margin="0,3,0,0" Foreground="{StaticResource SecondaryText}" FontSize="10" />
                </StackPanel>

                <Button Grid.Column="1" Content="{Binding ModifyLabel}" Style="{StaticResource TextOnlyButton}"
                        Padding="8,4" VerticalAlignment="Center" Click="SettingsButton_Click" />
            </Grid>
        </Border>

        <UniformGrid Grid.Row="8" Columns="4">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,4,0" Padding="9">
                <StackPanel>
                    <TextBlock Text="{Binding ResetLabel}" Foreground="{StaticResource SecondaryText}" FontSize="9" />
                    <TextBlock Text="{Binding ResetText}" Margin="0,5,0,0" FontSize="10" FontWeight="Bold" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="4,0" Padding="9">
                <StackPanel>
                    <TextBlock Text="{Binding ExhaustionLabel}" Foreground="{StaticResource SecondaryText}" FontSize="9" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding EstimatedExhaustionText}" Margin="0,5,0,0" FontSize="10" FontWeight="Bold" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="4,0" Padding="9">
                <StackPanel>
                    <TextBlock Text="{Binding SuggestedPaceLabel}" Foreground="{StaticResource SecondaryText}" FontSize="9" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SuggestedPaceText}" Margin="0,5,0,0" FontSize="10" FontWeight="Bold" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="4,0,0,0" Padding="9">
                <StackPanel>
                    <TextBlock Text="{Binding ObservedPaceLabel}" Foreground="{StaticResource SecondaryText}" FontSize="9" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding CurrentPaceText}" Margin="0,5,0,0" FontSize="10" FontWeight="Bold" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border x:Name="ErrorPanel" Grid.Row="10" Visibility="Collapsed"
                Background="#33A1281D" BorderBrush="#AAFF7369" BorderThickness="1"
                CornerRadius="8" Padding="7">
            <TextBlock Text="{Binding ErrorText}" Foreground="#FFFFA9A2" TextWrapping="Wrap" FontSize="9" />
        </Border>
    </Grid>
</Window>
